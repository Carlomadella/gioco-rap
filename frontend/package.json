{
  "name": "anni-di-fame",
  "version": "0.1.0",
  "private": true,
  "description": "Anni di Fame — il gioco. HTML, CSS e JavaScript; il build lo impacchetta per gli store.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node strumenti/dev.js",
    "build": "node strumenti/build.js",
    "demo": "node strumenti/build.js --unico",
    "prova": "node strumenti/prova.js",
    "test:unit": "vitest run test/unit",
    "test:unit:watch": "vitest test/unit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "setup:makehuman": "node strumenti/setup-makehuman.js",
    "verifica:build": "npm run build && npm run demo && node strumenti/verifica-build.js",
    "verifica:dipendenze": "npm audit --audit-level=high && npm audit --audit-level=high --prefix ../backend",
    "verifica": "npm run prova && node strumenti/audit-regressioni.js && npm run test:unit && npm run test:e2e && npm run verifica:build && npm run verifica:dipendenze"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  }
}
