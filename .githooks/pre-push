#!/bin/sh
set -eu

REMOTE_NAME="${1:-origin}"
ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
TMP="${TMPDIR:-/tmp}/adf-pre-push-$$"
trap 'rm -f "$TMP"' EXIT HUP INT TERM
cat > "$TMP"

# Un push deve verificare esattamente cio' che sta per uscire, non una working
# tree diversa dal commit. Include anche gli untracked: e' cosi' che evitiamo
# di testare file locali che poi non entrano davvero in Git.
if [ -n "$(git status --porcelain --untracked-files=all)" ]; then
  echo ""
  echo "[ADF GIT GATE] PUSH BLOCCATO: working tree non pulita."
  echo "Committa, scarta o ignora esplicitamente i file prima del push."
  echo ""
  git status --short
  exit 1
fi

# Aggiorna la fotografia di main usata per il controllo di freschezza.
if git remote get-url "$REMOTE_NAME" >/dev/null 2>&1; then
  git fetch --quiet "$REMOTE_NAME" main || {
    echo "[ADF GIT GATE] Impossibile aggiornare $REMOTE_NAME/main. Push bloccato."
    exit 1
  }
fi

NEED_VERIFY=0
while read -r LOCAL_REF LOCAL_OID REMOTE_REF REMOTE_OID; do
  [ -n "${LOCAL_REF:-}" ] || continue
  [ "$LOCAL_OID" = "$ZERO" ] && continue

  case "$REMOTE_REF" in
    refs/heads/*) NEED_VERIFY=1 ;;
    *) continue ;;
  esac

  if [ "$REMOTE_REF" = "refs/heads/main" ]; then
    # Nuova main remota non e' un caso normale per questo progetto.
    if [ "$REMOTE_OID" = "$ZERO" ]; then
      echo "[ADF GIT GATE] Creazione diretta di main bloccata."
      exit 1
    fi

    BAD=""
    for C in $(git rev-list --reverse "$REMOTE_OID..$LOCAL_OID"); do
      set -- $(git rev-list --parents -n 1 "$C")
      PARENTS=$(($# - 1))
      SUBJECT="$(git log -1 --format=%s "$C")"

      if [ "$PARENTS" -ge 2 ]; then
        continue
      fi
      if [ "$SUBJECT" = "docs: aggiorna registro modifiche" ]; then
        continue
      fi

      # Anche un merge fast-forward e' valido, ma solo se quel commit era gia'
      # stato pubblicato su un branch remoto diverso da main. In questo modo
      # il normale `git merge task/...` non viene penalizzato, mentre un commit
      # creato direttamente su main resta bloccato.
      ON_TASK_REMOTE="$(git branch -r --contains "$C" 2>/dev/null | sed 's/^[* ]*//' | grep -v "^$REMOTE_NAME/main$" | head -n 1 || true)"
      if [ -n "$ON_TASK_REMOTE" ]; then
        continue
      fi

      BAD="$C $SUBJECT"
      break
    done

    if [ -n "$BAD" ]; then
      echo ""
      echo "[ADF GIT GATE] PUSH SU main BLOCCATO."
      echo "Nel range da pubblicare c'e' un commit diretto, non un merge:"
      echo "  $BAD"
      echo "Le feature/fix devono entrare in main tramite merge da un branch di task."
      echo ""
      exit 1
    fi
  else
    MAIN_REF="refs/remotes/$REMOTE_NAME/main"
    if git show-ref --verify --quiet "$MAIN_REF"; then
      if ! git merge-base --is-ancestor "$MAIN_REF" "$LOCAL_OID"; then
        echo ""
        echo "[ADF GIT GATE] BRANCH VECCHIO: push bloccato."
        echo "Il commit che stai pushando non contiene l'ultimo $REMOTE_NAME/main."
        echo "Aggiorna il branch prima di continuare, poi rifai la verifica."
        echo ""
        echo "  git fetch $REMOTE_NAME"
        echo "  git rebase $REMOTE_NAME/main"
        echo ""
        exit 1
      fi
    fi
  fi
done < "$TMP"

if [ "$NEED_VERIFY" -eq 1 ]; then
  echo ""
  echo "[ADF GIT GATE] Eseguo la verifica ufficiale prima del push..."
  echo ""
  (cd "$ROOT/frontend" && npm run verifica)
fi
