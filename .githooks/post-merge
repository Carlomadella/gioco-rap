#!/bin/sh

BRANCH="$(git branch --show-current)"

if [ "$BRANCH" != "main" ]; then
    exit 0
fi

set -- $(git rev-list --parents -n 1 HEAD)

if [ "$#" -lt 3 ]; then
    exit 0
fi

echo ""
echo "=========================================="
echo " MERGE RILEVATO SU MAIN"
echo " Registro modifiche: aggiornamento affidato a GitHub Actions."
echo "=========================================="
echo ""

# Il registro viene generato e committato una sola volta dal workflow
# .github/workflows/registro-merge.yml. Il client locale non scrive file
# e non crea commit automatici dopo il merge.
exit 0
